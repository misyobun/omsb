---
import { Post } from '../lib/interfaces.ts'
import { getPostLink } from '../lib/blog-helpers.ts'
import NoContents from './NoContents.astro'

export interface Props {
  heading: string
  posts: Post[]
}

const { heading, posts } = Astro.props
---

<div class="blog-posts-link">
  <h2>{heading}</h2>
  {posts.length === 0 ? (
    <NoContents contents={posts} />
  ) : (
    <ul>
      {posts.map((post: Post) => (
        <li>
          <a
            href={getPostLink(post.Slug)}
            title={`${post.Icon?.Emoji || ''}${post.Title}`}
          >
            {post.Icon && post.Icon.Type === 'emoji' ? (
              <>
                <span>{post.Icon.Emoji}</span>
                {post.Title}
              </>
            ) : post.Icon && post.Icon.Type === 'external' ? (
              <>
                <img src={post.Icon.Url} alt="Post title icon in a link list" />
                {post.Title}
              </>
            ) : (
              post.Title
            )}
          </a>
        </li>
      ))}
    </ul>
  )}
</div>

<style>
  h2 {
    margin: 0 0 16px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  ul {
    list-style: none;
    counter-reset: posts;
    padding: 0;
    margin: 0 0 32px;
  }
  li {
    counter-increment: posts;
    display: flex;
    gap: 12px;
    padding: 14px 0;
    border-bottom: 1px solid var(--line);
  }
  li::before {
    content: counter(posts, decimal-leading-zero);
    font: 10px var(--font-mono);
    color: var(--accent);
    padding-top: 4px;
  }
  a {
    display: block;
    font-size: 13px;
    line-height: 1.7;
  }
  a span {
    margin-right: 4px;
  }
  a img {
    width: 18px;
    height: 18px;
    vertical-align: middle;
    margin-right: 4px;
  }
</style>
