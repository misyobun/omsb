---
import { PUBLIC_GA_TRACKING_ID, ENABLE_LIGHTBOX } from '../server-constants.ts'
import { getDatabase } from '../lib/notion/client.ts'
import { getNavLink, getStaticFilePath, filePath } from '../lib/blog-helpers.ts'
import '../styles/syntax-coloring.css'
import GoogleAnalytics from '../components/GoogleAnalytics.astro'
import SearchModal from '../components/SearchModal.astro'
import SearchButton from '../components/SearchButton.astro'
import '../styles/global.css'

export interface Props {
  title: string
  description: string
  path: string
  ogImage: string
}

const { title = '', description = '', path = '/', ogImage = '' } = Astro.props

const database = await getDatabase()

const siteTitle = title ? `${title} - ${database.Title}` : database.Title
const siteDescription = description ? description : database.Description
const siteURL = new URL(getNavLink(path), Astro.site).toString()
const siteOGImage = new URL(
  getStaticFilePath('/default-og-image.png'),
  Astro.site
)

let coverImageURL: string
if (database.Cover) {
  if (database.Cover.Type === 'external') {
    coverImageURL = database.Cover.Url
  } else if (database.Cover.Type === 'file') {
    try {
      coverImageURL = filePath(new URL(database.Cover.Url))
    } catch (err) {
      console.log('Invalid DB cover image URL')
    }
  }
}

let customIconURL: string
if (database.Icon && database.Icon.Type === 'file') {
  try {
    customIconURL = filePath(new URL(database.Icon.Url))
  } catch (err) {
    console.log('Invalid DB custom icon URL')
  }
}
---

<!doctype html>
<html lang="ja" prefix="og: https://ogp.me/ns#">
  <head>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="max-image-preview:large" />
    <meta charset="UTF-8" />
    <meta name="generator" content={Astro.generator} />
    <title>{siteTitle}</title>
    <meta name="description" content={siteDescription} />
    <link rel="canonical" href={siteURL} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${database.Title} RSS`}
      href={new URL(getNavLink('/feed.xml'), Astro.site).toString()}
    />
    <meta property="og:url" content={siteURL} />
    <meta property="og:title" content={siteTitle} />
    <meta property="og:description" content={siteDescription} />
    <meta property="og:site_name" content={database.Title} />
    <meta property="og:image" content={ogImage || siteOGImage} />
    <meta name="twitter:title" content={siteTitle} />
    <meta name="twitter:description" content={siteDescription} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage || siteOGImage} />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/katex@0.16.4/dist/katex.min.css"
      integrity="sha384-vKruj+a13U8yHIkAyGgK1J3ArTLzrFGBbBc0tDp4ad/EyewESeXE/Iv67Aj8gKZ0"
      crossorigin="anonymous"
    />
  </head>
  <body>
    <GoogleAnalytics trackingId={PUBLIC_GA_TRACKING_ID} />
    <a class="skip-link" href="#main-content">
      本文へスキップ
    </a>
    <div class="site-shell">
      <header class="site-header">
        <a
          class="brand"
          href={getNavLink('/')}
          aria-label={`${database.Title} ホーム`}
        >
          {database.Icon?.Type === 'emoji' ? (
            <span class="brand-icon">{database.Icon.Emoji}</span>
          ) : database.Icon?.Type === 'external' ? (
            <img src={database.Icon.Url} alt="" />
          ) : customIconURL ? (
            <img src={customIconURL} alt="" />
          ) : (
            <span class="brand-mark" aria-hidden="true">
              ＊
            </span>
          )}
          <span>{database.Title}</span>
        </a>
        <nav aria-label="メインナビゲーション">
          <a
            class="archive-link"
            href={getNavLink('/')}
            aria-current={path === '/' ? 'page' : undefined}
          >
            記事一覧
          </a>
          <a class="rss-link" href={getNavLink('/rss')}>
            RSS <span aria-hidden="true">↗</span>
          </a>
          <SearchButton />
        </nav>
      </header>

      {path === '/' && (
        <section
          class:list={['intro', { 'with-cover': coverImageURL }]}
          aria-label="ブログについて"
        >
          <div class="intro-copy">
            <p class="eyebrow">
              <span class="status-dot" /> A PERSONAL JOURNAL
            </p>
            <h1>
              {database.Title}
              <span class="title-dot">.</span>
            </h1>
            {database.Description && (
              <p class="description">{database.Description}</p>
            )}
            <a class="intro-link" href="#main-content">
              記事を読む <span aria-hidden="true">↓</span>
            </a>
          </div>
          {coverImageURL && (
            <div class="cover">
              <img src={coverImageURL} alt="" />
            </div>
          )}
          <span class="intro-index" aria-hidden="true">
            NOTES / IDEAS / DISCOVERIES
          </span>
        </section>
      )}

      <div
        class:list={[
          'content-layout',
          { 'has-aside': Astro.slots.has('aside') },
        ]}
      >
        <main id="main-content" tabindex="-1">
          <slot name="main" />
        </main>
        {Astro.slots.has('aside') && (
          <aside aria-label="おすすめ記事とカテゴリ">
            <slot name="aside" />
          </aside>
        )}
      </div>

      <footer class="site-footer">
        <div>
          <a class="footer-brand" href={getNavLink('/')}>
            {database.Title}
            <span class="title-dot">.</span>
          </a>
          <p>A collection of everyday discoveries.</p>
        </div>
        <div class="footer-right">
          <div class="social">
            <a
              href="https://www.twitter.com/misyobun"
              target="_blank"
              rel="noopener noreferrer"
            >
              X / Twitter ↗
            </a>
            <a
              href="https://www.github.com/misyobun"
              target="_blank"
              rel="noopener noreferrer"
            >
              GitHub ↗
            </a>
          </div>
          <span>
            Powered by{' '}
            <a href="https://github.com/otoyo/astro-notion-blog">
              astro-notion-blog
            </a>
          </span>
        </div>
      </footer>
    </div>

    <SearchModal />
    {ENABLE_LIGHTBOX && (
      <script src={getStaticFilePath('/scripts/fslightbox.js')} />
    )}
  </body>
</html>

<style>
  .site-shell {
    max-width: 1280px;
    margin: auto;
    padding: 0 48px;
  }
  .site-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: 100px;
    border-bottom: 1px solid var(--line);
  }
  .brand {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--fg);
    font-weight: 750;
    font-size: 19px;
    letter-spacing: -0.04em;
  }
  .brand > span:last-child {
    overflow-wrap: anywhere;
  }
  .brand img {
    width: 28px;
    height: 28px;
    border-radius: 6px;
  }
  .brand-mark {
    color: var(--accent);
    font-size: 36px;
    line-height: 1;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 28px;
    flex-shrink: 0;
    font-size: 13px;
    font-weight: 600;
  }
  nav a[aria-current] {
    color: var(--accent);
  }
  .intro {
    position: relative;
    padding: 76px 0 64px;
    border-bottom: 1px solid var(--line);
    margin-bottom: 48px;
  }
  .intro.with-cover {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .intro h1 {
    font-size: clamp(44px, 6.5vw, 86px);
    line-height: 1.12;
    letter-spacing: -0.065em;
    font-weight: 800;
    margin: 24px 0;
    overflow-wrap: anywhere;
  }
  .title-dot {
    color: var(--accent);
  }
  .description {
    max-width: 540px;
    font-size: 16px;
    color: var(--muted);
    line-height: 1.9;
  }
  .intro-link {
    display: inline-flex;
    align-items: center;
    gap: 28px;
    margin-top: 24px;
    font-size: 13px;
    font-weight: 700;
  }
  .intro-link span {
    color: var(--accent);
    font-size: 22px;
  }
  .cover {
    transform: rotate(2deg);
    border-radius: 4px;
    overflow: hidden;
    background: var(--surface);
  }
  .cover img {
    width: 100%;
    aspect-ratio: 4 / 3;
    display: block;
    object-fit: cover;
  }
  .intro-index {
    position: absolute;
    right: 0;
    bottom: 20px;
    font-family: var(--font-mono);
    font-size: 9px;
    letter-spacing: 0.15em;
    color: var(--muted);
  }
  .content-layout {
    padding: 40px 0 80px;
  }
  .has-aside {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 240px;
    gap: 64px;
  }
  main {
    min-width: 0;
  }
  aside {
    min-width: 0;
    padding-top: 8px;
  }
  .site-footer {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
    padding: 36px 0;
    border-top: 1px solid var(--line);
  }
  .footer-brand {
    font-size: 24px;
    font-weight: 750;
    letter-spacing: -0.04em;
  }
  .site-footer p,
  .footer-right > span {
    font-size: 11px;
    color: var(--muted);
  }
  .footer-right {
    text-align: right;
  }
  .social {
    display: flex;
    gap: 20px;
    justify-content: flex-end;
    margin-bottom: 16px;
    font-size: 12px;
  }
  @media (min-width: 761px) {
    .intro:not(.with-cover) .intro-copy {
      display: grid;
      grid-template-columns: 1.15fr 1fr;
      column-gap: 48px;
      align-items: center;
    }
    .intro:not(.with-cover) .eyebrow {
      grid-column: 1 / -1;
      margin-bottom: 22px;
    }
    .intro:not(.with-cover) h1 {
      grid-column: 1;
      grid-row: 2 / 4;
      margin: 0;
    }
    .intro:not(.with-cover) .description {
      grid-column: 2;
      margin: 0;
    }
    .intro:not(.with-cover) .intro-link {
      grid-column: 2;
      justify-self: start;
      margin-top: 16px;
    }
  }
  @media (max-width: 1000px) {
    .has-aside {
      gap: 32px;
      grid-template-columns: minmax(0, 1fr) 200px;
    }
    .site-shell {
      padding: 0 28px;
    }
  }
  @media (max-width: 760px) {
    .site-shell {
      padding: 0 20px;
    }
    .site-header {
      min-height: 80px;
      gap: 12px;
    }
    .brand {
      font-size: 16px;
    }
    nav {
      gap: 14px;
    }
    .rss-link {
      display: none;
    }
    .intro,
    .intro.with-cover {
      padding: 44px 0 52px;
      margin-bottom: 12px;
      grid-template-columns: 1fr;
      gap: 28px;
    }
    .intro h1 {
      font-size: clamp(40px, 10vw, 64px);
    }
    .cover {
      max-width: 100%;
      transform: none;
    }
    .cover img {
      aspect-ratio: 16 / 9;
    }
    .has-aside {
      grid-template-columns: 1fr;
      gap: 48px;
    }
    aside {
      border-top: 1px solid var(--line);
      padding-top: 32px;
    }
    .content-layout {
      padding: 28px 0 48px;
    }
    .site-footer {
      align-items: flex-start;
      flex-direction: column;
    }
    .footer-right {
      text-align: left;
    }
    .social {
      justify-content: flex-start;
    }
  }
  @media (max-width: 380px) {
    .archive-link {
      display: none;
    }
  }
</style>
